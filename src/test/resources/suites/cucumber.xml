<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- BDD suite. Scenarios are selected with -Dtags="@smoke and not @wip". -->
<suite name="API Automation - BDD" verbose="1" data-provider-thread-count="4">

    <listeners>
        <listener class-name="com.apiautomation.listeners.TestListener"/>
        <listener class-name="com.apiautomation.listeners.RetryTransformer"/>
    </listeners>

    <test name="Cucumber scenarios">
        <classes>
            <class name="com.apiautomation.bdd.runner.CucumberTestNgRunner"/>
        </classes>
    </test>
</suite>
