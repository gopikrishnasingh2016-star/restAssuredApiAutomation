{
  "priority": 4,
  "request": {
    "method": "POST",
    "urlPath": "/api/register",
    "headers": {
      "x-api-key": {
        "equalTo": "reqres-free-v1"
      }
    },
    "bodyPatterns": [
      {
        "doesNotMatch": ".*\"password\".*"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "error": "Missing password"
    }
  }
}
