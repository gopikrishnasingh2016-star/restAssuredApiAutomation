{
  "priority": 5,
  "request": {
    "method": "PATCH",
    "urlPathPattern": "/api/users/[0-9]+",
    "headers": { "x-api-key": { "equalTo": "reqres-free-v1" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json; charset=utf-8" },
    "body": "{\"name\":\"{{jsonPath request.body '$.name'}}\",\"job\":\"{{jsonPath request.body '$.job'}}\",\"updatedAt\":\"{{now format='yyyy-MM-dd HH:mm:ss'}}\"}",
    "transformers": ["response-template"]
  }
}
